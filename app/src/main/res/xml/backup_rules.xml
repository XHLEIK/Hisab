<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup rules for API 28-30. API 31+ uses data_extraction_rules.xml instead —
    keep the two in step, and see that file for why only this one directory is included
    (WAL-mode Room database and the INV-1 SMS hash cache must both stay out).
-->
<full-backup-content>
    <include domain="file" path="backups/" />
</full-backup-content>
